#!/usr/bin/env python3
"""End-to-end contracts for repo-owned CLI-agent state adapters."""
import contextlib
import importlib.machinery
import importlib.util
import json
import os
import shlex
import shutil
import subprocess
import tempfile
import unittest.mock
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
ADAPTER = ROOT / "resources" / "agent_state_adapters"
OSC = "\033]777;notify;warp://cli-agent;"
BEL = "\007"
PROTOCOL_ENV = {"WARP_CLI_AGENT_PROTOCOL_VERSION": "1", "WARP_CLIENT_VERSION": "test"}
PRIVACY_SENTINEL = "do-not-leak-secret-prompt"


def parse_osc(data):
    """Verify the OSC 777 envelope and return its protocol-v1 JSON payload."""
    assert data.startswith(OSC) and data.endswith(BEL), repr(data)
    payload = json.loads(data[len(OSC):-len(BEL)])
    assert payload["v"] == 1
    assert {"v", "agent", "event"} <= set(payload) <= {"v", "agent", "event", "query", "response"}
    return payload


def run_hook_command(command, payload, path, env=PROTOCOL_ENV):
    """Run an exact shipped Antigravity command with a pseudo-terminal."""
    shell_command = f"printf '%s' {shlex.quote(json.dumps(payload))} | {command}"
    run_env = {**os.environ, **env, "PATH": f"{path}:{os.environ['PATH']}"}
    for key in PROTOCOL_ENV:
        if key not in env:
            run_env.pop(key, None)
    return subprocess.run(
        ["/usr/bin/script", "-q", "/dev/null", "/bin/sh", "-c", shell_command],
        text=True,
        capture_output=True,
        env=run_env,
        timeout=5,
        check=True,
    )


def antigravity_hooks():
    hooks = json.loads((ADAPTER / "antigravity" / "hooks.json").read_text())
    return hooks["warp-42labs-agent-state"]


def assert_antigravity_hook(event, payload, expected_event=None, expected_stdout=None, env=PROTOCOL_ENV):
    if expected_stdout is None:
        expected_stdout = {}
    command = antigravity_hooks()[event][0]["command"]
    with tempfile.TemporaryDirectory() as bindir:
        binary = Path(bindir) / "warp-42labs-antigravity.py"
        shutil.copy2(ADAPTER / "antigravity" / binary.name, binary)
        binary.chmod(0o755)
        result = run_hook_command(command, payload, bindir, env)
    # macOS script emits this control sequence when its own stdin is not a TTY.
    output = result.stdout.removeprefix("^D\b\b")
    assert PRIVACY_SENTINEL not in output
    if expected_event is None:
        stdout = output
    else:
        prefix, osc = output.split(OSC, 1)
        assert prefix == ""
        encoded_event, stdout = osc.split(BEL, 1)
        assert parse_osc(OSC + encoded_event + BEL) == {"v": 1, "agent": "agy", "event": expected_event}
    assert json.loads(stdout) == expected_stdout


def test_antigravity_shipped_commands_and_recorded_payload_mapping():
    # Execute commands from the shipped JSON exactly, not a reconstructed command.
    assert_antigravity_hook("PreInvocation", {"unused": PRIVACY_SENTINEL}, "prompt_submit")
    for reason in (
        "NO_TOOL_CALL", "TERMINAL_STEP_TYPE", "TERMINAL_CUSTOM_HOOK", "INJECTED_RESPONSE",
        "EARLY_CONTINUE", "USER_CANCELED", "UNSPECIFIED", "model_stop",
    ):
        for value in (reason, reason.lower()):
            assert_antigravity_hook("Stop", {"fullyIdle": True, "terminationReason": value}, "stop")
    for reason in ("unrecognised", None, ""):
        payload = {"fullyIdle": True}
        if reason is not None:
            payload["terminationReason"] = reason
        assert_antigravity_hook("Stop", payload, "stop")
    for reason in (
        "ERROR", "HALTED_STEP", "MAX_INVOCATIONS", "MAX_FORCED_INVOCATIONS",
        "MAX_TOKEN_BUDGET_EXCEEDED", "MAX_STEPS_EXCEEDED",
    ):
        for value in (reason, reason.lower()):
            assert_antigravity_hook("Stop", {"fullyIdle": True, "terminationReason": value}, "stop_failure")
    assert_antigravity_hook(
        "Stop", {"fullyIdle": True, "terminationReason": "NO_TOOL_CALL", "error": "do-not-leak-secret-prompt"},
        "stop_failure",
    )
    assert_antigravity_hook(
        "Stop", {"fullyIdle": False}, None,
        {"decision": "continue", "reason": "Background work is still active."},
    )
    for env in (
        {},
        {"WARP_CLI_AGENT_PROTOCOL_VERSION": "2", "WARP_CLIENT_VERSION": "test"},
        {"WARP_CLI_AGENT_PROTOCOL_VERSION": "1"},
    ):
        # Hook stdout remains valid JSON while the adapter suppresses OSC without
        # a compatible Warp client and protocol environment.
        assert_antigravity_hook("PreInvocation", {}, env=env)


def pi_entry(role, content="", stop_reason=None):
    if role == "assistant" and isinstance(content, str):
        content = [{"type": "text", "text": content}] if content else []
    message = {"role": role, "content": content}
    if stop_reason is not None:
        message["stopReason"] = stop_reason
    return {
        "type": "message",
        "id": f"{role}-id",
        "parentId": None,
        "timestamp": "2026-09-13T00:00:00.000Z",
        "message": message,
    }


def run_pi_event(name, branch=None, env=PROTOCOL_ENV):
    extension = ADAPTER / "pi" / "warp-42labs.ts"
    driver = """
const extension = (await import(process.argv[1])).default;
const handlers = {};
extension({ on: (name, handler) => { handlers[name] = handler; } });
const name = process.argv[2];
const branch = JSON.parse(process.argv[3]);
const event = JSON.parse(process.argv[4]);
handlers[name]?.(event, { sessionManager: { getBranch: () => branch } });
"""
    run_env = {**os.environ, **env}
    for key in PROTOCOL_ENV:
        if key not in env:
            run_env.pop(key, None)
    output = subprocess.run(
        ["bun", "-e", driver, str(extension), name, json.dumps(branch or []), json.dumps({"unused": PRIVACY_SENTINEL})],
        text=True, capture_output=True, env=run_env, check=True,
    ).stdout
    assert PRIVACY_SENTINEL not in output
    return output


def test_pi_recorded_event_mapping_and_gating():
    for name, expected in (
        ("session_start", "session_start"), ("agent_start", "prompt_submit"),
        ("ui_prompt_start", "permission_request"), ("ui_prompt_end", "permission_replied"),
    ):
        assert parse_osc(run_pi_event(name)) == {"v": 1, "agent": "pi", "event": expected}

    for reason in ("stop", "length", "aborted"):
        branch = [pi_entry("user", "question"), pi_entry("assistant", "answer", reason)]
        assert parse_osc(run_pi_event("agent_settled", branch)) == {
            "v": 1, "agent": "pi", "event": "stop", "query": "question", "response": "answer",
        }
    branch = [pi_entry("user", "question"), pi_entry("assistant", "answer", "error")]
    assert parse_osc(run_pi_event("agent_settled", branch)) == {
        "v": 1, "agent": "pi", "event": "stop_failure", "query": "question", "response": "answer",
    }
    skill = (
        '<skill name="deploy" location="/absolute/path/that-must-not-leak">\n'
        f"{PRIVACY_SENTINEL}\n</skill>\n\n--dry-run"
    )
    output = run_pi_event("agent_settled", [pi_entry("user", skill), pi_entry("assistant", "answer", "stop")])
    assert PRIVACY_SENTINEL not in output
    assert parse_osc(output) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "/skill:deploy --dry-run", "response": "answer",
    }
    long_text = "x" * 201
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", long_text), pi_entry("assistant", long_text, "stop"),
    ])) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "x" * 197 + "...", "response": "x" * 197 + "...",
    }
    astral_text = "x" * 196 + "😀" + "y" * 4
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", astral_text), pi_entry("assistant", astral_text, "stop"),
    ])) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "x" * 196 + "😀...", "response": "x" * 196 + "😀...",
    }
    for reason in ("deferred", "pending", "toolUse", "unknown", None):
        assert run_pi_event("agent_settled", [pi_entry("assistant", "answer", reason)]) == ""
    assert run_pi_event("agent_settled", []) == ""
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("assistant", "answer", "stop"), {"type": "custom", "message": {"role": "assistant"}},
    ])) == {"v": 1, "agent": "pi", "event": "stop", "response": "answer"}
    assert parse_osc(run_pi_event("agent_settled", [pi_entry("assistant", "answer", "stop")])) == {
        "v": 1, "agent": "pi", "event": "stop", "response": "answer",
    }
    assert parse_osc(run_pi_event("agent_settled", [pi_entry("user", "question"), pi_entry("assistant", "", "stop")])) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "question",
    }
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", "old question"), pi_entry("assistant", "old answer", "stop"),
        pi_entry("user", "current question"), pi_entry("assistant", "", "error"),
    ])) == {"v": 1, "agent": "pi", "event": "stop_failure", "query": "current question"}
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", "old question"), pi_entry("assistant", "old answer", "stop"),
        pi_entry("user", [{"type": "image", "data": "ignored"}]), pi_entry("assistant", "current answer", "stop"),
    ])) == {"v": 1, "agent": "pi", "event": "stop", "response": "current answer"}
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", "old question"), pi_entry("assistant", "old answer", "stop"),
        pi_entry("assistant", "current answer", "stop"),
    ])) == {"v": 1, "agent": "pi", "event": "stop", "response": "current answer"}
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", "question"), pi_entry("assistant", "", "toolUse"),
        pi_entry("toolResult", "tool output"), pi_entry("assistant", "answer", "stop"),
    ])) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "question", "response": "answer",
    }
    assert parse_osc(run_pi_event("agent_settled", [
        pi_entry("user", "question"), pi_entry("assistant", "retry", "error"),
        pi_entry("assistant", "", "toolUse"), pi_entry("toolResult", "tool output"),
        pi_entry("assistant", "answer", "stop"),
    ])) == {
        "v": 1, "agent": "pi", "event": "stop", "query": "question", "response": "answer",
    }
    assert run_pi_event("agent_end", [pi_entry("assistant", "answer", "stop")]) == ""
    for env in ({}, {"WARP_CLI_AGENT_PROTOCOL_VERSION": "2", "WARP_CLIENT_VERSION": "test"}, {"WARP_CLI_AGENT_PROTOCOL_VERSION": "1"}):
        assert run_pi_event("agent_start", env=env) == ""


@contextlib.contextmanager
def temporary_environ(updates):
    previous = {key: os.environ.get(key) for key in updates}
    for key, value in updates.items():
        if value is None:
            os.environ.pop(key, None)
        else:
            os.environ[key] = value
    try:
        yield
    finally:
        for key, value in previous.items():
            if value is None:
                os.environ.pop(key, None)
            else:
                os.environ[key] = value


def capture_hermes(callback, env=PROTOCOL_ENV, *args, **kwargs):
    read_fd, write_fd = os.pipe()
    saved = os.dup(1)
    environment = {key: env.get(key) for key in PROTOCOL_ENV}
    environment.update(env)
    try:
        os.dup2(write_fd, 1)
        with temporary_environ(environment):
            callback(*args, **kwargs)
    finally:
        os.dup2(saved, 1)
        os.close(saved)
        os.close(write_fd)
    result = os.read(read_fd, 4096).decode()
    os.close(read_fd)
    return result


def hermes_declared_hooks():
    lines = (ADAPTER / "hermes" / "plugin.yaml").read_text().splitlines()
    start = lines.index("provides_hooks:") + 1
    return {
        line.strip().removeprefix("- ")
        for line in lines[start:]
        if line.startswith("  - ")
    }


def test_hermes_callbacks_privacy_api_error_omission_and_gating():
    path = ADAPTER / "hermes" / "__init__.py"
    spec = importlib.util.spec_from_file_location("warp_42labs_hermes", path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    secret = PRIVACY_SENTINEL
    for callback, expected in (
        (module.on_session_start, "session_start"), (module.pre_llm_call, "prompt_submit"),
        (module.pre_approval_request, "permission_request"), (module.post_approval_response, "permission_replied"),
    ):
        output = capture_hermes(callback, PROTOCOL_ENV, prompt=secret, response=secret, error=secret)
        assert secret not in output
        assert parse_osc(output) == {"v": 1, "agent": "hermes", "event": expected}
    assert parse_osc(capture_hermes(module.on_session_end, PROTOCOL_ENV, failed=False, payload=secret)) == {
        "v": 1, "agent": "hermes", "event": "stop",
    }
    assert parse_osc(capture_hermes(module.on_session_end, PROTOCOL_ENV, failed=True, payload=secret)) == {
        "v": 1, "agent": "hermes", "event": "stop_failure",
    }
    for env in ({}, {"WARP_CLI_AGENT_PROTOCOL_VERSION": "2", "WARP_CLIENT_VERSION": "test"}, {"WARP_CLI_AGENT_PROTOCOL_VERSION": "1"}):
        assert capture_hermes(module.pre_llm_call, env, prompt=secret) == ""

    registered = {}
    module.register(type("Context", (), {"register_hook": lambda _, name, callback: registered.setdefault(name, callback)})())
    declared = hermes_declared_hooks()
    assert declared == set(registered) == {
        "on_session_start", "pre_llm_call", "on_session_end", "pre_approval_request", "post_approval_response",
    }
    assert "post_llm_call" not in declared and "post_llm_call" not in registered


def install(args, env):
    subprocess.run([str(ROOT / "script" / "install_agent_state_adapters"), args], env=env, check=True)


def load_installer():
    path = ROOT / "script" / "install_agent_state_adapters"
    spec = importlib.util.spec_from_loader(
        "install_agent_state_adapters",
        importlib.machinery.SourceFileLoader("install_agent_state_adapters", str(path)),
    )
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def test_backup_preserves_each_distinct_rewrite_with_a_fixed_timestamp():
    installer = load_installer()
    fixed_time = installer.datetime.datetime(2026, 9, 10, 21, 0, 0)
    with tempfile.TemporaryDirectory() as temp:
        config = Path(temp) / "hooks.json"
        config.write_text("first prior config\n")
        with unittest.mock.patch.object(
            installer.datetime, "datetime", wraps=installer.datetime.datetime
        ) as clock:
            clock.now.return_value = fixed_time
            installer.backup(config)
            config.write_text("second prior config\n")
            installer.backup(config)
        backups = sorted(config.parent.glob("hooks.json.bak.*"))
        assert len(backups) == 2
        assert {backup.read_text() for backup in backups} == {
            "first prior config\n",
            "second prior config\n",
        }


def test_antigravity_installer_uses_warposs_data_dir_by_default():
    with tempfile.TemporaryDirectory() as temp:
        home = Path(temp)
        env = {**os.environ, "HOME": str(home)}
        env.pop("WARP_DATA_DIR", None)

        install("--antigravity", env)

        assert (home / ".warp-oss/agent_state_adapters/warp-42labs-antigravity.py").exists()
        assert not (home / "Library/Application Support/Warp-42labs").exists()


def test_antigravity_installer_honors_warp_data_dir_override():
    with tempfile.TemporaryDirectory() as temp:
        home = Path(temp)
        override = home / "custom-warp-data"
        env = {**os.environ, "HOME": str(home), "WARP_DATA_DIR": str(override)}

        install("--antigravity", env)

        assert (override / "agent_state_adapters/warp-42labs-antigravity.py").exists()
        assert not (home / ".warp-oss").exists()


def make_fake_hermes(bindir):
    hermes = bindir / "hermes"
    hermes.write_text(
        "#!/usr/bin/env python3\n"
        "import json, os, sys\n"
        "from pathlib import Path\n"
        "home = Path(os.environ['HERMES_HOME'])\n"
        "marker = home / 'plugins/warp-42labs/enable-invocation.json'\n"
        "marker.write_text(json.dumps({'argv': sys.argv[1:], 'hermes_home': str(home)}))\n"
    )
    hermes.chmod(0o755)


def hermetic_installer_env(home, hermes_home, bindir):
    return {
        **os.environ,
        "HOME": str(home),
        "HERMES_HOME": str(hermes_home),
        "WARP_DATA_DIR": str(home / "data"),
        "PATH": f"{bindir}:{os.environ['PATH']}",
    }


def assert_hermes_enable_is_hermetic(home, hermes_home):
    marker = hermes_home / "plugins/warp-42labs/enable-invocation.json"
    assert json.loads(marker.read_text()) == {
        "argv": ["plugins", "enable", "warp-42labs", "--no-allow-tool-override"],
        "hermes_home": str(hermes_home),
    }
    assert not (home / ".hermes").exists()


def test_hermes_enable_subprocess_explicitly_forwards_hermes_home():
    installer = load_installer()
    with tempfile.TemporaryDirectory() as temp:
        hermes_home = Path(temp) / "hermes-state"
        with temporary_environ({"HERMES_HOME": str(hermes_home)}), \
             unittest.mock.patch.object(installer.shutil, "which", return_value="hermes"), \
             unittest.mock.patch.object(installer.subprocess, "run") as run:
            installer.hermes()
        assert run.call_args.kwargs["env"]["HERMES_HOME"] == str(hermes_home)


def test_installer_target_isolation_backup_byte_stability_and_all():
    with tempfile.TemporaryDirectory() as temp, tempfile.TemporaryDirectory() as bindir:
        home = Path(temp)
        hermes_home = home / "hermes-state"
        make_fake_hermes(Path(bindir))
        env = hermetic_installer_env(home, hermes_home, bindir)
        config = home / ".gemini/config/hooks.json"
        config.parent.mkdir(parents=True)
        original = {"user-hook": {"Stop": []}}
        config.write_text(json.dumps(original) + "\n")

        install("--antigravity", env)
        assert json.loads(config.read_text())["user-hook"] == original["user-hook"]
        assert not (home / ".pi").exists() and not (home / ".hermes").exists()
        backups = list(config.parent.glob("hooks.json.bak.*"))
        assert len(backups) == 1 and json.loads(backups[0].read_text()) == original
        antigravity_bytes = config.read_bytes()
        install("--antigravity", env)
        assert config.read_bytes() == antigravity_bytes
        assert len(list(config.parent.glob("hooks.json.bak.*"))) == 1

        install("--pi", env)
        pi_path = home / ".pi/agent/extensions/warp-42labs.ts"
        assert pi_path.exists() and not (home / ".hermes").exists()
        install("--hermes", env)
        hermes_dir = hermes_home / "plugins/warp-42labs"
        assert (hermes_dir / "plugin.yaml").exists() and (hermes_dir / "__init__.py").exists()
        assert_hermes_enable_is_hermetic(home, hermes_home)

    with tempfile.TemporaryDirectory() as temp, tempfile.TemporaryDirectory() as bindir:
        home = Path(temp)
        hermes_home = home / "hermes-state"
        make_fake_hermes(Path(bindir))
        env = hermetic_installer_env(home, hermes_home, bindir)
        install("--all", env)
        paths = [
            home / ".gemini/config/hooks.json",
            home / "data/agent_state_adapters/warp-42labs-antigravity.py",
            home / ".pi/agent/extensions/warp-42labs.ts",
            hermes_home / "plugins/warp-42labs/plugin.yaml",
            hermes_home / "plugins/warp-42labs/__init__.py",
        ]
        first = {path: path.read_bytes() for path in paths}
        install("--all", env)
        assert {path: path.read_bytes() for path in paths} == first
        assert_hermes_enable_is_hermetic(home, hermes_home)


def test_shipped_hermes_plugin_doctor():
    result = subprocess.run(
        ["hermes", "plugins", "doctor", str(ADAPTER / "hermes"), "--ci"],
        text=True, capture_output=True, check=True,
    )
    assert "WARN:" not in result.stdout


def main():
    test_antigravity_shipped_commands_and_recorded_payload_mapping()
    test_pi_recorded_event_mapping_and_gating()
    test_hermes_callbacks_privacy_api_error_omission_and_gating()
    test_backup_preserves_each_distinct_rewrite_with_a_fixed_timestamp()
    test_antigravity_installer_uses_warposs_data_dir_by_default()
    test_antigravity_installer_honors_warp_data_dir_override()
    test_hermes_enable_subprocess_explicitly_forwards_hermes_home()
    test_installer_target_isolation_backup_byte_stability_and_all()
    test_shipped_hermes_plugin_doctor()
    print("agent state adapter contracts: PASS")


if __name__ == "__main__":
    main()
